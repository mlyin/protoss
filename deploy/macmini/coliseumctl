#!/usr/bin/env bash
# coliseumctl — manage the Coliseum launchd services on this Mac.
#   coliseumctl status | start | stop | restart | logs [api|fleet] | mode <sim|paper|testnet> | funnel [off] | url
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
LA="$HOME/Library/LaunchAgents"
UID_="$(id -u)"
PORT="$(grep -E '^PORT=' "$ROOT/backend/.env" 2>/dev/null | cut -d= -f2 || true)"; PORT="${PORT:-8000}"
SVCS="com.coliseum.api com.coliseum.fleet"

ts() { command -v tailscale >/dev/null 2>&1 && echo tailscale || { [ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ] && echo /Applications/Tailscale.app/Contents/MacOS/Tailscale; }; }

cmd="${1:-status}"; shift || true
case "$cmd" in
  start)
    for s in $SVCS; do launchctl bootstrap "gui/$UID_" "$LA/$s.plist" 2>/dev/null || launchctl kickstart "gui/$UID_/$s"; done ;;
  stop)
    for s in com.coliseum.fleet com.coliseum.api; do launchctl bootout "gui/$UID_/$s" 2>/dev/null || true; done ;;
  restart)
    for s in com.coliseum.fleet com.coliseum.api; do launchctl bootout "gui/$UID_/$s" 2>/dev/null || true; done
    for s in $SVCS; do launchctl bootstrap "gui/$UID_" "$LA/$s.plist"; done ;;
  status)
    for s in $SVCS; do
      if launchctl print "gui/$UID_/$s" >/dev/null 2>&1; then
        pid="$(launchctl print "gui/$UID_/$s" | awk '/pid = /{print $3}')"
        printf '%-18s running (pid %s)\n' "$s" "${pid:-?}"
      else
        printf '%-18s stopped\n' "$s"
      fi
    done
    curl -fsS "http://127.0.0.1:$PORT/health" 2>/dev/null && echo || echo "API not answering on :$PORT"
    if [ -f "$ROOT/.fleet-keys.json" ]; then
      tok="$(grep -E '^ADMIN_TOKEN=' "$ROOT/backend/.env" | cut -d= -f2- | tr -d '"')"
      (cd "$ROOT" && ADMIN_TOKEN="$tok" ARENA_URL="http://127.0.0.1:$PORT" .venv/bin/python scripts/fleet.py --status 2>/dev/null) || true
    fi ;;
  logs)
    which="${1:-api}"; exec tail -n 80 -f "$ROOT/logs/com.coliseum.$which.log" ;;
  mode)
    m="${1:?sim|paper|testnet}"
    sed -i '' -E "s/^ARENA_MODE=.*/ARENA_MODE=$m/" "$ROOT/backend/.env"
    echo "ARENA_MODE=$m"; "$0" restart ;;
  funnel)
    TS="$(ts || true)"; [ -z "$TS" ] && { echo "Tailscale not installed (https://tailscale.com/download/mac)"; exit 1; }
    if [ "${1:-}" = "off" ]; then "$TS" funnel --https=443 off; echo "funnel off"; exit 0; fi
    "$TS" funnel --bg --https=443 "http://127.0.0.1:$PORT"
    echo; "$TS" funnel status 2>/dev/null | head -20 ;;
  url)
    echo "local:     http://localhost:$PORT"
    ip="$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || true)"; [ -n "$ip" ] && echo "LAN:       http://$ip:$PORT"
    TS="$(ts || true)"; if [ -n "$TS" ]; then
      tip="$("$TS" ip -4 2>/dev/null | head -1 || true)"; [ -n "$tip" ] && echo "Tailscale: http://$tip:$PORT"
      "$TS" funnel status 2>/dev/null | grep -Eo 'https://[^ ]+' | head -1 | sed 's/^/public:    /' || true
    fi ;;
  *)
    sed -n '2,3p' "$0"; exit 1 ;;
esac
