# sim | paper | testnet
ARENA_MODE=sim
ADMIN_TOKEN=change-me
DATABASE_URL=sqlite:///./arena.db
# Supabase: DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# testnet only — generate with: python -m app.keygen ; fund at https://app.hyperliquid-testnet.xyz/drip
# HL_MASTER_PRIVATE_KEY=0x...
# HL_BUILDER_ADDRESS=0x...        # defaults to the master address
HL_BUILDER_FEE_TENTHS_BP=30       # 0.03% per fill
HL_PERP_DEXS=["xyz"]              # HIP-3 deployers to load markets from

TICK_SECONDS=5
SNAPSHOT_SECONDS=60
